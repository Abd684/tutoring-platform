{
  "info": {
    "name": "Liqaa - Implemented Teacher APIs",
    "description": "Only the APIs listed in ملف api لقاء.txt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "teacherId", "value": "1" },
    { "key": "teacherSubjectId", "value": "1" },
    { "key": "unitId", "value": "1" },
    { "key": "lessonId", "value": "1" },
    { "key": "contentId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Teacher Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ahmad Ali\",\n  \"email\": \"teacher@example.com\",\n  \"phone\": \"0999999999\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"region_id\": 1,\n  \"specialization\": \"Mathematics\",\n  \"bio\": \"Math teacher\"\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/register"
      }
    },
    {
      "name": "02 - Teacher Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"Password123!\"\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "if (body.access_token) pm.collectionVariables.set('accessToken', body.access_token);",
        "if (body.refresh_token) pm.collectionVariables.set('refreshToken', body.refresh_token);"
      ] }}]
    },
    {
      "name": "03 - Teacher Refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/refresh"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "if (body.access_token) pm.collectionVariables.set('accessToken', body.access_token);",
        "if (body.refresh_token) pm.collectionVariables.set('refreshToken', body.refresh_token);"
      ] }}]
    },
    {
      "name": "04 - Current Teacher",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/teacher/me"
      }
    },
    {
      "name": "05 - Teacher Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/logout"
      }
    },
    {
      "name": "06 - Teacher Subjects",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/teachers/{{teacherId}}/subjects" }
    },
    {
      "name": "07 - Subject Units",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/teacher/subjects/{{teacherSubjectId}}/units" }
    },
    {
      "name": "08 - Unit Lessons",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/units/{{unitId}}/lessons" }
    },
    {
      "name": "09 - Lesson Contents",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/lessons/{{lessonId}}/contents" }
    },
    {
      "name": "10 - Create Content",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"lesson_id\": {{lessonId}},\n  \"type\": \"video\",\n  \"title\": \"Lesson introduction\",\n  \"description\": \"Introduction video\",\n  \"order_no\": 1,\n  \"status\": \"draft\",\n  \"published_at\": null\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/contents"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "if (body.data && body.data.id) pm.collectionVariables.set('contentId', body.data.id);"
      ] }}]
    },
    {
      "name": "11 - Create Content Asset",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"disk\": \"public\",\n  \"storage_key\": \"contents/videos/video-1.mp4\",\n  \"mime_type\": \"video/mp4\",\n  \"file_size\": 5242880,\n  \"checksum\": \"sha256-value\",\n  \"encryption_type\": \"AES-256\",\n  \"encryption_status\": \"pending\",\n  \"status\": \"active\"\n}" },
        "url": "{{baseUrl}}/api/v1/teacher/contents/{{contentId}}/asset"
      }
    }
  ]
}
